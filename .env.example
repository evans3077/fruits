# Application URL (used for canonical links and payment callback documentation)
APP_URL=http://localhost:3000

# Admin bootstrap email (first matching verified Firebase user automatically receives owner role;
# if unset, the first authenticated user when no owner exists can claim ownership)
ADMIN_BOOTSTRAP_EMAIL=owner@example.com

# IntaSend Kenya Payment Gateway (leave INTASEND_SECRET_KEY blank for Development Payment Simulator mode)
# Prefix ISSecretKey_test_... activates IntaSend Sandbox; ISSecretKey_live_... activates Live mode
INTASEND_SECRET_KEY=
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_example_placeholder
INTASEND_WEBHOOK_CHALLENGE=blendy-dev-webhook-challenge

# Optional Transactional Notification Adapters (leave blank to skip outbound webhooks in testing)
EMAIL_WEBHOOK_URL=
SMS_WEBHOOK_URL=
